# ==============================================================================
# Agent-Stream Voice Agent — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in the blanks. `.env` is gitignored.
# Secrets are left BLANK; non-secret settings show their default value.
# Only values that differ from the defaults need to be set.
# ==============================================================================

# ===== VOICE BOT MODE =====
# "modular"  = Deepgram (STT) + Gemini (LLM) + Sarvam (TTS)  [default]
# "realtime" = OpenAI Realtime API (speech-to-speech)
VOICE_BOT_MODE=modular

# ===== MODULAR PIPELINE (REQUIRED when VOICE_BOT_MODE=modular) =====
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=neha
SARVAM_LANGUAGE_CODE=hi-IN

# ===== OPENAI REALTIME (REQUIRED when VOICE_BOT_MODE=realtime; also fallback) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-realtime-mini
OPENAI_VOICE=coral

# ===== DATABASE (MongoDB) =====
# DB_URL is the Mongo connection string (must include the database name).
# Needed to resolve agents, knowledge bases, OAuth tokens, call logs.
DB_URL=
DATABASE_URL=

# ===== RAG: CHROMA VECTOR DB + S3 + GCP =====
CHROMA_HOST=localhost
CHROMA_PORT=8000

# AWS S3 (stores uploaded knowledge-base documents)
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Google Cloud service-account JSON (alternative to GEMINI_API_KEY for Gemini/embeddings).
# Path to the mounted key file; leave blank if using GEMINI_API_KEY instead.
GOOGLE_APPLICATION_CREDENTIALS=

# ===== WHATSAPP API (send_whatsapp tool) =====
# Legacy single-tenant template-send endpoint: POST {"to","templateName","languageCode"}.
# Leave WHATSAPP_API_URL blank to run the WhatsApp tool in MOCK mode (logs, no send).
# Tip: for local testing against prod, expose your backend via ngrok and use that URL.
WHATSAPP_API_URL=https://unascendable-damningly-rossana.ngrok-free.dev/api/whatsapp/send-template
WHATSAPP_API_TOKEN=

# Internal multi-tenant voice-agent WhatsApp endpoint (preferred). Resolves the
# enterprise's WhatsApp account + template by tenantId server-side; this app only
# sends {customerPhone, type:"template", templateName, tenantId, bodyParameters?}.
# Auth is the x-api-key header. Use a STABLE host (not an ngrok URL — those expire).
# Leave INTERNAL_WHATSAPP_API_URL blank to run the WhatsApp tool in MOCK mode.
INTERNAL_WHATSAPP_API_URL=
INTERNAL_API_KEY=

# ===== EMAIL: SMTP (send_email tool, global fallback tier) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Chauwk Sales Team
SMTP_FROM_EMAIL=

# ===== GOOGLE OAUTH (Gmail send-as + Calendar scheduling) =====
# Must match the OAuth client used by the /auth/google/{id} connect flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# ===== TELEPHONY: EXOTEL + SIP TRUNK =====
USE_SIP_TRUNK=true
INBOUND_SIP_ENABLED=true
SIP_SERVER_HOST=0.0.0.0
SIP_SERVER_PORT=5060
SIP_PUBLIC_IP=              # REQUIRED for incoming calls — the server's public IP
EXOTEL_SIP_TRANSPORT=TLS

# Exotel REST API (outbound calls only)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.in.exotel.com

# ===== SERVER =====
SERVER_HOST=0.0.0.0
SERVER_PORT=5002
SERVER_BASE_URL=https://ai.chauwk.com
LOG_LEVEL=INFO
PRODUCTION_MODE=false

# ===== BOT PERSONALITY =====
COMPANY_NAME=TechSolutions Inc.

# ===== OPTIONAL TUNING (defaults shown; override only if needed) =====
# SPECULATIVE_RAG=true
# SAMPLE_RATE=24000
# AUDIO_GAIN=1.5
# SARVAM_PACE=1.15
# MAX_CONCURRENT_CALLS=100
# CALL_TIMEOUT_SECONDS=1800
# DISABLE_AI_ENGINES=false     # true = skip AI-key validation (testing only)
